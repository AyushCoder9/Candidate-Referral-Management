# Server Configuration
PORT=5000

# MongoDB Connection String
# Example: mongodb://localhost:27017/candidate_referral (Local)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ (Atlas)
MONGO_URI=

# JWT Secret for signing tokens (Any long random string)
JWT_SECRET=

# AWS S3 Configuration for Resume Uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
