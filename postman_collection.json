							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/candidates/:id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"candidates",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "123"
								}
							]
						}
					},
					"response": []
